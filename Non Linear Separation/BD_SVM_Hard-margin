def cross_validate_gamma(X, y, gammas, n_splits=5, random_state=0):
    """
    Validation croisée k-fold pour choisir gamma.

    X : données d'entrée (déjà prétraitées)
    y : labels (-1, +1)
    gammas : liste de valeurs de gamma à tester
    n_splits : nombre de folds (par défaut 5)
    """
    kf = KFold(n_splits=n_splits, shuffle=True, random_state=random_state)
    results = {}

    for gamma in gammas:
        print(f"\n===== Testing gamma = {gamma} =====")
        accs = []

        # définir le noyau pour cette valeur de gamma
        kernel = lambda a, b, g=gamma: rbf_kernel(a, b, gamma=g)

        # boucle sur les folds
        for fold_idx, (train_idx, val_idx) in enumerate(kf.split(X)):
            X_tr, X_val = X[train_idx], X[val_idx]
            y_tr, y_val = y[train_idx], y[val_idx]

            # entraînement sur le fold d'entraînement
            lambd = svm_kernel_train(X_tr, y_tr, kernel)
            b = compute_bias(X_tr, y_tr, lambd, kernel)

            # évaluation sur le fold de validation
            preds = np.array([
                predict(x, X_tr, y_tr, lambd, b, kernel) for x in X_val
            ])
            acc = (preds == y_val).mean()
            accs.append(acc)

            print(f"Fold {fold_idx+1} accuracy = {acc:.3f}")

        mean_acc = np.mean(accs)
        results[gamma] = mean_acc
        print(f"--> Mean CV accuracy for gamma={gamma} : {mean_acc:.3f}")

    # meilleur gamma
    best_gamma = max(results, key=results.get)
    best_acc = results[best_gamma]
    print("\n===== Cross-validation result =====")
    print(f"Best gamma = {best_gamma} with mean CV accuracy = {best_acc:.3f}")

    return best_gamma, best_acc, results

